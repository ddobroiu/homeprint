generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "linux-musl-arm64-openssl-3.0.x", "debian-openssl-1.1.x", "debian-openssl-3.0.x", "linux-arm64-openssl-1.1.x", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String               @id @default(cuid())
  email               String
  source              String               @default("homeprint.ro") // 'shopprint.ro' sau 'homeprint.ro'
  name                String?
  phone               String?
  passwordHash        String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  emailVerified       DateTime?
  image               String?
  role                String               @default("user")
  stripeCustomerId    String?              @unique

  @@unique([email, source])
  
  accounts            Account[]
  sessions            Session[]
  orders              Order[]
  addresses           Address[]
  reviews             Review[]
  aiConversations     AiConversation[]
  passwordResetTokens PasswordResetToken[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Address {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  label      String?
  nume       String?
  email      String?
  telefon    String?
  country    String   @default("RO")
  judet      String
  localitate String
  strada_nr  String
  postCode   String?
  bloc       String?
  scara      String?
  etaj       String?
  ap         String?
  interfon   String?
  company    String?
  cui        String?
  regCom     String?
  isDefault  Boolean  @default(false)
  type       String   @default("shipping")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Order {
  id               String      @id @default(cuid())
  orderNo          Int         @unique @default(autoincrement())
  userId           String?
  user             User?       @relation(fields: [userId], references: [id])
  status           String      @default("pending")
  totalAmount      Decimal
  paymentMethod    String
  shippingAddress  Json // Stocăm obiect complet JSON
  billingAddress   Json // Stocăm obiect complet JSON
  invoiceUrl       String?
  awbNumber        String?
  awbCarrier       String?
  shippingFee      Decimal?     @default(0)
  source           String       @default("homeprint.ro") // 'shopprint.ro' or 'homeprint.ro'
  type             String       @default("order") // "order" | "offer"
  awbLabelBase64   String?
  awbLabelFileName String?
  canceledAt       DateTime?
  items            OrderItem[]
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  stripeSessionId  String?     @unique
  
  marketing        Json?
  termsAcceptedAt  DateTime? // momentul acceptării Termenilor și a Politicii de confidențialitate în checkout
  termsVersion     String?   // versiunea documentelor legale acceptate (lib/company.ts → LEGAL_VERSION)
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String?
  name      String
  quantity  Int
  price     Decimal
  total     Decimal?
  metadata  Json?
  artworkUrl String?
}

model PendingCheckout {
  id           String   @id @default(cuid())
  sessionId    String   @unique
  checkoutData Json
  expiresAt    DateTime
  createdAt    DateTime @default(now())
}

model DiscountCode {
  id             String    @id @default(cuid())
  code           String    @unique
  type           String    
  value          Float     
  minOrderValue  Float?    @default(0)
  maxUses        Int?      
  currentUses    Int       @default(0)
  validFrom      DateTime  @default(now())
  validUntil     DateTime
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Review {
  id          String   @id @default(cuid())
  rating      Int
  title       String?
  content     String
  createdAt   DateTime @default(now())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productSlug String
  
  @@index([productSlug])
}

model Subscriber {
  id        String   @id @default(cuid())
  email     String
  source    String?
  createdAt DateTime @default(now())

  @@unique([email, source])
}

model AiConversation {
  id            String      @id @default(cuid())
  source        String
  identifier    String
  userId        String?
  hasError      Boolean     @default(false)
  isRead        Boolean     @default(false)
  lastMessageAt DateTime    @default(now())
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  aiPaused      Boolean     @default(false)
  customTag     String?
  status        String      @default("active")
  user          User?       @relation(fields: [userId], references: [id])
  messages      AiMessage[]
}

model AiMessage {
  id             String         @id @default(cuid())
  conversationId String
  role           String
  content        String
  createdAt      DateTime       @default(now())
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}

model AbandonedCart {
  id              String   @id @default(cuid())
  email           String
  configuratorId  String
  cartData        Json
  emailSentCount  Int      @default(0)
  lastEmailSent   DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  source          String   @default("homeprint.ro")

  @@unique([email, configuratorId])
}

/// Generări AI: previzualizare mică + filigran; print full quality doar la comandă.
model AiGraphicGeneration {
  id                String   @id @default(cuid())
  ipHash            String
  previewUrl        String   @unique
  cleanPublicId     String?
  printWidthCm      Int      @default(100)
  printHeightCm     Int      @default(100)
  userPrompt        String   @default("") @db.Text
  imagePrompt       String?  @db.Text
  product           String?
  productKind       String?
  material          String?
  referenceImageUrl String?
  mode              String   @default("create")
  productionStatus  String   @default("preview")
  orderId           String?
  createdAt         DateTime @default(now())

  @@index([ipHash, createdAt])
  @@index([orderId])
  @@index([productionStatus])
}

/// Cerere de retragere dintr-un contract la distanță (OUG 18/2026 - dreptul de retur).
model WithdrawalRequest {
  id          String   @id @default(cuid())
  name        String
  email       String
  phone       String?
  orderRef    String   // numărul comenzii/contractului introdus de client
  products    String   @db.Text
  message     String?  @db.Text
  status      String   @default("pending") // pending, accepted, rejected
  source      String   @default("homeprint.ro")
  createdAt   DateTime @default(now())
}

// Cheltuiala pe reclame (Google Ads, trimisa de scriptul din cont), un rand pe campanie pe zi.
// Baza e comuna tuturor site-urilor de print: modelul e in schema fiecaruia, ca db push sa nu-l stearga.
model AdSpendDaily {
  id              String   @id @default(cuid())
  provider        String
  date            DateTime @db.Date
  campaignId      String
  campaignName    String
  currency        String
  spend           Decimal  @db.Decimal(14, 2)
  impressions     Int      @default(0)
  clicks          Int      @default(0)
  conversions     Decimal  @default(0) @db.Decimal(14, 2)
  conversionValue Decimal  @default(0) @db.Decimal(14, 2)
  updatedAt       DateTime @updatedAt

  @@unique([provider, date, campaignId])
  @@index([date])
}

// Tracking propriu al site-urilor de print (www.shopprint.ro/t.js): o vizita = un rand.
// Sursa (Google, Facebook, reclame, direct...) se stabileste la prima pagina.
model TrackVisit {
  id           String   @id
  visitorId    String
  host         String
  date         DateTime @db.Date
  startedAt    DateTime @default(now())
  lastSeenAt   DateTime @default(now())
  landingPath  String
  referrerHost String?
  source       String
  medium       String
  campaign     String?
  clickType    String?
  device       String
  pageviews    Int      @default(1)

  @@index([date])
  @@index([host, date])
}

// Datele pentru „Date și rapoarte” din admin-ul shopprint (Search Console, GA4, Bing, Merchant, alerte, reclame).
// Baza e comuna site-urilor de print: modelele stau si aici, ca `prisma db push` sa nu le stearga.

// Google Search Console, pe site pe zi
model PrintGscDaily {
  site        String
  date        DateTime @db.Date
  clicks      Int
  impressions Int
  position    Float

  @@id([site, date])
  @@index([date])
}

// Topul cautarilor si al paginilor: ultimele 28 de zile cu date ("cur") si cele 28 dinainte ("prev")
model PrintGscTop {
  id          String @id @default(cuid())
  site        String
  kind        String // query | page
  period      String // cur | prev
  key         String
  clicks      Int
  impressions Int
  position    Float

  @@index([site, kind, period])
}

// Google Analytics 4 pe site, zi si canal; channel "(total)" = vizitatorii unici ai zilei
model PrintGa4Daily {
  site      String
  date      DateTime @db.Date
  channel   String
  users     Int
  sessions  Int
  purchases Int
  revenue   Decimal  @db.Decimal(14, 2)

  @@id([site, date, channel])
  @@index([date])
}

// Paginile de intrare din GA4 (ultimele 30 de zile), cu vanzarile lor
model PrintGa4Landing {
  id          String   @id @default(cuid())
  site        String
  path        String
  sessions    Int
  purchases   Int
  revenue     Decimal  @db.Decimal(14, 2)
  periodStart DateTime @db.Date
  periodEnd   DateTime @db.Date

  @@index([site])
}

// Bing Webmaster, pe site pe zi
model PrintBingDaily {
  site        String
  date        DateTime @db.Date
  clicks      Int
  impressions Int

  @@id([site, date])
}

// Google Merchant Center: o poza pe zi a starii produselor
model PrintMerchantSnapshot {
  date          DateTime @id @db.Date
  total         Int
  approved      Int
  pending       Int
  disapproved   Int
  issues        Json
  accountIssues Json
  updatedAt     DateTime @updatedAt
}

// Ultima citire din fiecare sursa (gsc, ga4, bing, merchant, google-ads, meta-ads)
model PrintSyncState {
  source    String    @id
  lastRunAt DateTime?
  lastOkAt  DateTime?
  lastError String?
  info      Json?
}

// Alertele adminului de print (scadere clicuri/comenzi, citiri esuate, produse respinse)
model PrintAlert {
  key        String    @id
  kind       String
  site       String?
  message    String
  active     Boolean   @default(true)
  firstAt    DateTime  @default(now())
  lastAt     DateTime  @default(now())
  resolvedAt DateTime?

  @@index([active])
}

// Campaniile de reclame si site-ul caruia ii apartin (dupa nume sau dupa adresa din reclame)
model PrintAdCampaign {
  provider   String
  campaignId String
  name       String
  site       String?
  updatedAt  DateTime @updatedAt

  @@id([provider, campaignId])
}

// Microsoft Clarity pe site pe zi: cum se poarta vizitatorii (o citire pe zi, API-ul da doar ultimele 24 de ore).
// date = ziua citirii minus una (citirea de dimineata acopera in mare ziua de ieri). Timpii in secunde / sesiune.
model PrintClarityDaily {
  site            String
  date            DateTime @db.Date
  sessions        Int
  botSessions     Int
  users           Int
  pagesPerSession Float?
  scrollDepth     Float?
  totalTime       Float?
  activeTime      Float?
  rageClicks      Int
  rageSessions    Int
  deadClicks      Int
  deadSessions    Int
  quickbacks      Int
  excessiveScroll Int
  scriptErrors    Int
  errorSessions   Int
  errorClicks     Int
  pages           Json?
  fetchedAt       DateTime @default(now())

  @@id([site, date])
  @@index([date])
}

// Consumul AI al site-urilor de print (lib/aiUsage.ts, identic in cele 6 site-uri). Tabele create cu prisma/sql/20260929_print_insights.sql.
// Pe zi (ora Romaniei), site, furnizor, model si functie; calls = apeluri reusite, errors = esuate, unpriced = apeluri fara pret cunoscut (ex. imagini).
model PrintAiUsageDaily {
  site         String
  date         DateTime @db.Date
  provider     String
  model        String
  feature      String
  calls        Int      @default(0)
  errors       Int      @default(0)
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  cachedTokens Int      @default(0)
  costUsd      Float    @default(0)
  unpriced     Int      @default(0)
  updatedAt    DateTime @default(now()) @updatedAt

  @@id([site, date, provider, model, feature])
  @@index([date])
}

// Erorile recente ale apelurilor AI (kind: credit | auth | rate | other)
model PrintAiError {
  id       String   @id @default(cuid())
  site     String
  provider String
  model    String
  feature  String
  kind     String
  message  String
  at       DateTime @default(now())

  @@index([at])
  @@index([site, at])
}

// Bugetul AI pe site (USD); fara rand: 2 $/zi, 20 $/luna
model PrintAiBudget {
  site       String   @id
  dailyUsd   Float    @default(2)
  monthlyUsd Float    @default(20)
  updatedAt  DateTime @default(now()) @updatedAt
}

// Alertele AI trimise pe e-mail (deduplicare: credit/cheie max 1 pe 24 h, bugetul o data pe zi / luna)
model PrintAiAlert {
  key     String   @id
  kind    String
  site    String?
  message String
  sentAt  DateTime @default(now())

  @@index([sentAt])
}

// ─── Emailuri automate (coș abandonat, mulțumire, recomandări) ─────────────
// Identice în schema tuturor celor 6 site-uri de print (baza e comună).
// Trimiterea se face din shopprint (lib/mail-auto, /api/cron/emails); fiecare site doar captează coșul și dezabonarea.

model MailCart {
  id         String    @id @default(cuid())
  email      String
  name       String?
  site       String
  items      Json
  total      Decimal?
  status     String    @default("open") // open | converted | done | stopped
  step       Int       @default(0) // câte emailuri de coș s-au trimis
  lastSentAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([email, site])
  @@index([status, updatedAt])
}

model MailOptOut {
  email     String   @id
  site      String?
  reason    String?
  createdAt DateTime @default(now())
}

model MailSend {
  id       String   @id @default(cuid())
  email    String
  site     String
  kind     String // cart1 | cart2 | thanks | reco | welcome
  refId    String? // comanda / coșul / abonatul
  code     String? // codul de reducere trimis (DiscountCode.code)
  resendId String?
  error    String?
  sentAt   DateTime @default(now())

  @@index([email, kind])
  @@index([sentAt])
}

model MailSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}


// --- WhatsApp inbox (copiat din shopprint, aceeasi baza de date) ---
model WhatsAppContact {
  id            String                 @id @default(cuid())
  waId          String                 @unique // numărul în format WhatsApp, ex. 40750473111
  phone         String? // 07xxxxxxxx
  name          String? // din agenda telefonului (smb_app_state_sync) sau pus din admin
  profileName   String? // numele de profil WhatsApp
  email         String?
  userId        String?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  conversations WhatsAppConversation[]
}

model WhatsAppConversation {
  id                 String            @id @default(cuid())
  contactId          String            @unique
  lastMessageAt      DateTime?
  lastMessagePreview String?
  lastDirection      String? // in | out
  lastInboundAt      DateTime? // ultimul mesaj al clientului: fereastra de 24h
  unreadCount        Int               @default(0)
  hasMedia           Boolean           @default(false)
  orderId            String?
  orderNo            Int?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  contact            WhatsAppContact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  messages           WhatsAppMessage[]

  @@index([lastMessageAt])
}

model WhatsAppMessage {
  id             String               @id @default(cuid())
  conversationId String
  waMessageId    String?              @unique
  direction      String // in | out
  source         String // customer | phone | admin
  type           String // text | image | document | audio | video | sticker | location | contacts | interactive | button | reaction | unsupported
  text           String?
  mediaId        String?
  mediaUrl       String?
  mediaMime      String?
  mediaFilename  String?
  mediaSize      Int?
  mediaStatus    String? // pending | stored | too_large | failed
  replyToWaId    String?
  status         String? // received | sent | delivered | read | failed
  error          String?
  orderId        String?
  fromHistory    Boolean              @default(false)
  raw            Json?
  timestamp      DateTime
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  conversation   WhatsAppConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, timestamp])
  @@index([mediaStatus])
}

// ---------- Costuri și profit pe comandă (/admin/profit) ----------
// Costul real de producție (PrintCenter), transportul și comisioanele plătite de noi, pe comandă.
// Fără relație Prisma spre "Order" (doar orderId), ca tabelul să fie strict aditiv. Baza e comună
// celor 6 site-uri de print: modelele sunt copiate identic și în schemele lor.

model OrderCost {
  id                 String   @id @default(cuid())
  orderId            String   @unique
  printcenterOrderNo String? // nr. comenzii la PrintCenter (ex. 115337)
  productionCost     Decimal? @db.Decimal(12, 2) // cost real producție, lei FĂRĂ TVA (gol = estimat)
  shippingCost       Decimal? @db.Decimal(12, 2) // transport plătit de noi, lei FĂRĂ TVA (gol = implicit)
  paymentFee         Decimal? @db.Decimal(12, 2) // comision plată (Stripe / ramburs), lei (gol = calculat)
  otherCost          Decimal? @db.Decimal(12, 2) // alte costuri (grafică externă, ambalaj), lei fără TVA
  note               String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([printcenterOrderNo])
}

model ProfitSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// --- Inbox E-mail (copiat din shopprint, aceeasi baza de date; altfel db push la deploy le-ar sterge) ---
// Pe server nu se șterge / mută / marchează nimic (EXAMINE + BODY.PEEK). Starea (citit, rezolvat,
// arhivat) e doar aici. Baza e comună celor 6 site-uri de print: modelele sunt copiate și în schemele lor.

model EmailMailbox {
  id          String    @id @default(cuid())
  address     String // contact@shopprint.ro
  folder      String    @default("INBOX") // INBOX | INBOX.Sent
  label       String?
  uidValidity BigInt?
  lastUid     Int       @default(0)
  lastSyncAt  DateTime?
  lastError   String?
  lastErrorAt DateTime?
  lockedUntil DateTime? // o singură sincronizare odată
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([address, folder])
}

model EmailThread {
  id              String         @id @default(cuid())
  mailboxAddress  String
  subject         String
  normSubject     String // fără Re:/Fwd:, litere mici: legarea răspunsurilor fără In-Reply-To
  site            String? // shopprint | prynt | euprint | homeprint | adbanner | tablou
  category        String         @default("inbox") // inbox | production | spam | bulk | system
  customerEmail   String? // adresa clientului (Reply-To / From), litere mici
  customerName    String?
  customerPhone   String?
  lastMessageAt   DateTime
  lastPreview     String?
  lastDirection   String? // in | out
  unreadCount     Int            @default(0)
  messageCount    Int            @default(0)
  hasAttachments  Boolean        @default(false)
  possibleOrder   Boolean        @default(false)
  orderScore      Int            @default(0)
  orderSignals    String[]       @default([])
  productionRefs  Int[]          @default([]) // numerele de comandă din mesajele cu PrintCenter
  productionReady Int[]          @default([]) // „Comanda N este gata de livrare”
  status          String         @default("open") // open | done | archived
  orderId         String?
  orderNo         Int?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  messages        EmailMessage[]

  @@index([lastMessageAt])
  @@index([customerEmail])
  @@index([normSubject])
  @@index([category, status])
}

model EmailMessage {
  id              String            @id @default(cuid())
  threadId        String
  mailboxAddress  String
  folder          String?
  uid             Int?
  uidValidity     BigInt?
  direction       String // in | out
  messageId       String            @unique // Message-ID fără <> (dedublare: același mesaj venit de două ori)
  inReplyTo       String?
  references      String[]          @default([])
  fromEmail       String?
  fromName        String?
  replyTo         String?
  to              Json? // [{ address, name }]
  cc              Json?
  subject         String?
  site            String?
  category        String            @default("inbox")
  text            String?
  html            String? // curățat (fără scripturi; imaginile externe blocate până la „Încarcă imaginile”)
  hasRemoteImages Boolean           @default(false)
  orderScore      Int               @default(0)
  orderSignals    String[]          @default([])
  productionRefs  Int[]             @default([])
  productionReady Int[]             @default([])
  sentAt          DateTime // antetul Date
  receivedAt      DateTime? // INTERNALDATE
  source          String? // imap | admin
  sendVia         String? // resend | smtp
  sendStatus      String? // sent | failed
  error           String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  thread          EmailThread       @relation(fields: [threadId], references: [id], onDelete: Cascade)
  attachments     EmailAttachment[]

  @@index([threadId, sentAt])
  @@index([fromEmail])
}

model EmailAttachment {
  id        String       @id @default(cuid())
  messageId String
  idx       Int? // poziția în mesaj (mailparser) → descărcare la cerere din IMAP
  partId    String? // partea IMAP (mesajele prea mari, descărcate fără conținut)
  filename  String
  mime      String
  size      Int          @default(0)
  contentId String?
  inline    Boolean      @default(false)
  url       String? // Cloudinary, după salvare
  status    String       @default("imap") // imap (la cerere) | stored | failed
  error     String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  message   EmailMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
}

// Cheltuieli (/admin/cheltuieli): facturi de la furnizori (PrintCenter, DPD, reclame, găzduire...), plătite sau nu.
// Unic pe (furnizor, număr factură), ca importurile (e-mail PrintCenter, SPV) să poată face upsert.
// Sumele sunt în lei. Fără chei străine spre "Order" (orderIds = id-urile comenzilor noastre legate).
model Expense {
  id             String    @id @default(cuid())
  supplier       String // „PrintCenter”, „DPD”, „Meta Ads”...
  category       String    @default("altele") // productie | transport | reclame | it | abonamente | comisioane | altele
  number         String? // nr. facturii furnizorului
  issueDate      DateTime
  dueDate        DateTime?
  amountExVat    Decimal?  @db.Decimal(12, 2)
  vatAmount      Decimal?  @db.Decimal(12, 2)
  total          Decimal   @db.Decimal(12, 2) // de plată, cu TVA
  status         String    @default("unpaid") // unpaid | paid
  paidAt         DateTime?
  paymentMethod  String? // card | transfer | numerar | compensare
  site           String    @default("comun") // shopprint.ro / prynt.ro / ... / comun
  note           String?
  pdfRef         String? // URL sau cheia fișierului (Cloudinary authenticated / R2)
  pdfName        String?
  orderIds       String[]  @default([])
  pcOrderNumbers String[]  @default([]) // comenzile PrintCenter facturate
  source         String    @default("manual") // manual | email | import | spv
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([supplier, number])
  @@index([issueDate])
  @@index([category])
  @@index([status])
}
