# === Bază de date (Postgres nou, separat de celelalte site-uri) ===
DATABASE_URL=

# === Site ===
NEXT_PUBLIC_SITE_URL=https://www.homeprint.ro
PUBLIC_BASE_URL=https://www.homeprint.ro
NEXT_PUBLIC_ALLOWED_ORIGIN=https://www.homeprint.ro

# === Auth (NextAuth) - genereaza cu: openssl rand -base64 32 ===
AUTH_SECRET=
NEXTAUTH_SECRET=
NEXTAUTH_URL=https://www.homeprint.ro

# === Email (Resend) ===
RESEND_API_KEY=
EMAIL_FROM=contact@homeprint.ro
ADMIN_EMAIL=
SUPPORT_EMAIL=contact@homeprint.ro

# === Stripe (cont nou sau acelasi cont, cu webhook separat pt homeprint.ro) ===
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# === Oblio (facturare) - confirma daca homeprint factureaza pe aceeasi firma ===
OBLIO_CLIENT_ID=
OBLIO_CLIENT_SECRET=
OBLIO_CIF_FIRMA=
OBLIO_SERIE_FACTURA=

# === Cloudinary (upload imagini) ===
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# === DPD (curierat) ===
DPD_USERNAME=
DPD_PASSWORD=
DPD_SENDER_CLIENT_ID=
DPD_DEFAULT_SERVICE_ID=

# === Hub ShopPrint (trimite fiecare comanda catre dashboard-ul central) ===
# URL-ul de ingest de pe shopprint.ro + secretul Bearer configurat acolo
# (vezi app/api/integrations/order-ingest/route.ts in shopprint-main)
SHOPPRINT_ORDER_INGEST_URL=https://www.shopprint.ro/api/integrations/order-ingest
ORDER_INGEST_SECRET=

# === Admin ===
ADMIN_ACTION_SECRET=

# === AI (chat assistant + WhatsApp) === cheia proiectului OpenAI „homeprint”
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# === Microsoft Clarity (se încarcă numai cu consimțământ la statistică; implicit ID-ul din lib/clarity.ts) ===
NEXT_PUBLIC_CLARITY_ID=ypl8w39zfm

# === TikTok Pixel (se încarcă numai cu consimțământ la marketing; implicit ID-ul din lib/tiktok.ts) ===
NEXT_PUBLIC_TIKTOK_PIXEL_ID=DATFTEBC77UA36CC6CPG

# === TikTok Events API (CompletePayment trimis de server după plata cu cardul, numai cu consimțământ la marketing) ===
TIKTOK_EVENTS_TOKEN=
# opțional; implicit pixelul de mai sus
TIKTOK_PIXEL_ID=DATFTEBC77UA36CC6CPG
# numai pentru testare în TikTok Events Manager (ex. TEST12345); gol în producție
TIKTOK_TEST_EVENT_CODE=

# Meta Conversions API (lib/metaCapi.ts): Purchase de pe server (plată Stripe + ramburs), numai cu acord pentru marketing.
# Pixelul (dataset) e TRACKING.metaPixelId din lib/company.ts; META_PIXEL_ID il poate suprascrie.
# Fara META_CAPI_TOKEN nu se trimite nimic. META_TEST_EVENT_CODE = codul din Events Manager > Test Events (doar la verificare).
# META_CAPI_DRY_RUN=1 doar scrie in log ce s-ar trimite (fara date personale), nu trimite.
META_CAPI_TOKEN=
META_PIXEL_ID=
META_TEST_EVENT_CODE=
META_CAPI_DRY_RUN=
