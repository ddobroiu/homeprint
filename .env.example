# === Bază de date (Postgres nou, separat de celelalte site-uri) ===
DATABASE_URL=

# === Site ===
NEXT_PUBLIC_SITE_URL=https://www.homeprint.ro
PUBLIC_BASE_URL=https://www.homeprint.ro
NEXT_PUBLIC_ALLOWED_ORIGIN=https://www.homeprint.ro

# === Auth (NextAuth) - genereaza cu: openssl rand -base64 32 ===
AUTH_SECRET=
NEXTAUTH_SECRET=
NEXTAUTH_URL=https://www.homeprint.ro

# === Email (Resend) ===
RESEND_API_KEY=
EMAIL_FROM=contact@homeprint.ro
ADMIN_EMAIL=
SUPPORT_EMAIL=contact@homeprint.ro

# === Stripe (cont nou sau acelasi cont, cu webhook separat pt homeprint.ro) ===
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# === Oblio (facturare) - confirma daca homeprint factureaza pe aceeasi firma ===
OBLIO_CLIENT_ID=
OBLIO_CLIENT_SECRET=
OBLIO_CIF_FIRMA=
OBLIO_SERIE_FACTURA=

# === Cloudinary (upload imagini) ===
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# === DPD (curierat) ===
DPD_USERNAME=
DPD_PASSWORD=
DPD_SENDER_CLIENT_ID=
DPD_DEFAULT_SERVICE_ID=

# === Hub ShopPrint (trimite fiecare comanda catre dashboard-ul central) ===
# URL-ul de ingest de pe shopprint.ro + secretul Bearer configurat acolo
# (vezi app/api/integrations/order-ingest/route.ts in shopprint-main)
SHOPPRINT_ORDER_INGEST_URL=https://www.shopprint.ro/api/integrations/order-ingest
ORDER_INGEST_SECRET=

# === Admin ===
ADMIN_ACTION_SECRET=

# === AI (chat assistant) ===
OPENAI_API_KEY=
